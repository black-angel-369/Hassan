# Public site URL — used for canonical URL, Open Graph, sitemap and robots.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). All three are required;
# if any is missing, the form honestly falls back to opening the visitor's email app.
# These are server-only — never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=muhammadhassannadeem37@gmail.com
# Must be an address on a domain you have verified in Resend, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
